# Copia este archivo como ".env" y escribe tu llave. El archivo .env NUNCA se sube ni se comparte.
# Crea tu llave en https://console.anthropic.com (sección API keys). No la pegues en el chat.
ANTHROPIC_API_KEY=

# Modelo de IA (cuesta distinto). Por defecto el más barato: claude-haiku-5-5. Otros: claude-sonnet-5-5 | claude-opus-5-5
AI_MODEL=claude-haiku-5-5

# Freno de emergencia: máximo de pedidos de IA por día entre todos los usuarios
IA_MAX_DIARIO=200

# Supabase: dirección del proyecto, llave pública (publishable) y llave secreta (solo servidor, nunca en el navegador)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
